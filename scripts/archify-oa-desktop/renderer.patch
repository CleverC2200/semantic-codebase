+<script>
+(() => {
+  const graph = document.querySelector('.diagram-container');
+  const svg = graph.querySelector(':scope > svg');
+  if (!svg || document.documentElement.dataset.embed === 'true') return;
+  const legend = svg.querySelector('[data-legend]');
+  if (legend) legend.setAttribute('aria-hidden', 'true');
+  const nodes = [...svg.querySelectorAll('[data-node-id]')];
+  const nodeById = new Map(nodes.map(node => [node.dataset.nodeId, node]));
+  const edges = [...new Map([...svg.querySelectorAll('[data-edge-id]')]
+    .map(edge => [edge.dataset.edgeId, edge])).values()];
+  const section = document.createElement('section');
+  section.className = 'oa-reading-tools no-print';
+  section.setAttribute('aria-label', '图例与文字阅读');
+  const bar = document.createElement('div');
+  bar.className = 'oa-reading-bar';
+  const kinds = document.createElement('div');
+  kinds.className = 'oa-reading-kinds';
+  kinds.setAttribute('role', 'group');
+  kinds.setAttribute('aria-label', '按类型查看模块');
+  const kindButtons = [];
+  for (const entry of svg.querySelectorAll('[data-legend-kind]')) {
+    const kind = entry.dataset.legendKind;
+    const label = entry.dataset.legendLabel || kind;
+    const count = nodes.filter(node => node.dataset.nodeKind === kind).length;
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.dataset.oaKind = kind;
+    button.setAttribute('aria-pressed', 'false');
+    button.setAttribute('aria-controls', 'semantic-lens');
+    button.setAttribute('aria-expanded', 'false');
+    button.setAttribute('aria-label', `查看${label}，${count}个模块`);
+    const swatch = document.createElement('span');
+    swatch.className = 'oa-kind-swatch';
+    swatch.style.setProperty('--oa-kind-color', `var(--${kind}-stroke)`);
+    swatch.setAttribute('aria-hidden', 'true');
+    const countLabel = document.createElement('span');
+    countLabel.className = 'oa-kind-count';
+    countLabel.textContent = String(count);
+    countLabel.setAttribute('aria-hidden', 'true');
+    button.append(swatch, document.createTextNode(label), countLabel);
+    button.addEventListener('click', event => {
+      event.stopPropagation();
+      if (window.matchMedia('(max-width: 720px)').matches) graph.scrollIntoView({ block: 'start', behavior: 'instant' });
+      Archify.semanticLens.select(kind);
+      Archify.semanticLens.open({ opener: button });
+      syncKinds();
+    });
+    kinds.append(button);
+    kindButtons.push(button);
+  }
+  function syncKinds() {
+    const selected = Archify.semanticLens.active() || [];
+    const open = Archify.semanticLens.isOpen();
+    for (const button of kindButtons) {
+      const active = selected.includes(button.dataset.oaKind);
+      button.setAttribute('aria-pressed', String(active));
+      button.setAttribute('aria-expanded', String(open && active));
+      button.disabled = selected.length >= 2 && !active;
+    }
+  }
+  new MutationObserver(syncKinds).observe(document.getElementById('semantic-lens'), {
+    attributes: true, attributeFilter: ['hidden', 'data-dock-side']
+  });
+  new MutationObserver(syncKinds).observe(svg, {
+    attributes: true, attributeFilter: ['data-lens-active']
+  });
+  window.addEventListener('hashchange', syncKinds);
+
+  const reading = document.createElement('details');
+  reading.className = 'oa-text-reading';
+  const summary = document.createElement('summary');
+  summary.textContent = '文字阅读';
+  summary.setAttribute('aria-label', `文字阅读：${nodes.length}个模块、${edges.length}条关系`);
+  const content = document.createElement('div');
+  content.className = 'oa-reading-content';
+  const tabs = document.createElement('div');
+  tabs.className = 'oa-reading-tabs';
+  tabs.setAttribute('role', 'group');
+  tabs.setAttribute('aria-label', '选择文字内容');
+  const nodeList = document.createElement('ul');
+  nodeList.className = 'oa-reading-list';
+  nodeList.id = 'oa-reading-nodes';
+  const edgeList = document.createElement('ul');
+  edgeList.className = 'oa-reading-list';
+  edgeList.id = 'oa-reading-edges';
+  edgeList.hidden = true;
+  function makeTab(label, list, other) {
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.textContent = label;
+    button.setAttribute('aria-controls', list.id);
+    button.setAttribute('aria-pressed', String(!list.hidden));
+    button.addEventListener('click', () => {
+      list.hidden = false;
+      other.hidden = true;
+      for (const item of tabs.children) item.setAttribute('aria-pressed', String(item === button));
+    });
+    return button;
+  }
+  tabs.append(makeTab(`模块 ${nodes.length}`, nodeList, edgeList), makeTab(`关系 ${edges.length}`, edgeList, nodeList));
+  function row(list, title, detail, action) {
+    const item = document.createElement('li');
+    const button = document.createElement('button');
+    button.type = 'button';
+    const strong = document.createElement('strong');
+    strong.textContent = title;
+    const description = document.createElement('span');
+    description.textContent = detail;
+    button.append(strong, description);
+    button.addEventListener('click', () => {
+      reading.open = false;
+      action();
+      requestAnimationFrame(() => graph.scrollIntoView({ block: 'nearest', behavior: 'instant' }));
+    });
+    item.append(button);
+    list.append(item);
+  }
+  for (const node of nodes) {
+    const id = node.dataset.nodeId;
+    const sources = Archify.sourceEvidence.node(id);
+    row(nodeList, node.dataset.nodeLabel, `${node.dataset.nodeSublabel || ''} · 来源 ${sources.length}`, () => {
+      Archify.focus.set(id, { toggle: false });
+      node.focus({ preventScroll: true });
+    });
+  }
+  for (const edge of edges) {
+    const from = nodeById.get(edge.dataset.edgeFrom);
+    const to = nodeById.get(edge.dataset.edgeTo);
+    if (!from || !to) continue;
+    row(edgeList, `${from.dataset.nodeLabel} → ${to.dataset.nodeLabel}`, edge.dataset.edgeLabel || '有向关系', () => {
+      Archify.focus.inspectRelationshipById(edge.dataset.edgeId, { toggle: false });
+      document.getElementById('focus-chip').focus({ preventScroll: true });
+    });
+  }
+  const caption = document.createElement('p');
+  caption.className = 'oa-reading-caption';
+  caption.textContent = '与图中模块、职责和关系一致；选择一项查看详情和来源。';
+  content.append(tabs, caption, nodeList, edgeList);
+  reading.append(summary, content);
+  bar.append(kinds, reading);
+  section.append(bar);
+  graph.after(section);
+  reading.addEventListener('keydown', event => {
+    if (event.key !== 'Escape') return;
+    event.preventDefault();
+    event.stopPropagation();
+    reading.open = false;
+    summary.focus();
+  });
+  syncKinds();
+})();
+
+</script>
